# Backend
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productivity_app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=productivity_app
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Encryption (for Canvas API tokens)
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# Canvas Sync
CANVAS_SYNC_INTERVAL_MINUTES=30

# Feature Flags
FEATURE_CANVAS_INTEGRATION=true
FEATURE_GAMIFICATION=true
FEATURE_HABITS=true
FEATURE_SCHEDULING=true
FEATURE_ANALYTICS=true
FEATURE_AI_ENHANCEMENT=false

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000
