{
  "name": "productivity-app-backend",
  "version": "1.0.0",
  "description": "Backend API for Productivity Gamification App",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
